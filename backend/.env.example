# StudyFlow backend configuration — copy to `backend/.env` and fill in.
# (backend/.env is gitignored; never commit real secrets.)

# --- Core Django ---
DEBUG=True
SECRET_KEY=change-me-to-a-long-random-string
# Comma-separated hostnames Django will serve.
ALLOWED_HOSTS=localhost,127.0.0.1

# --- CORS ---
# Comma-separated frontend origins allowed to call the API.
# Leave as-is for local dev; set to your deployed frontend origin(s) in production.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Database ---
# Either set USE_POSTGRES=True with the DB_* vars below, or provide a single
# DATABASE_URL (postgres://user:pass@host:port/name). With neither, Django falls
# back to a local SQLite file (dev only).
USE_POSTGRES=True
DB_NAME=studyflow
DB_USER=studyflow_user
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432
# DATABASE_URL=postgresql://user:pass@host:5432/dbname
DB_SSLMODE=prefer

# --- Supabase auth (JWT verification via JWKS) ---
# The backend verifies Supabase-issued JWTs; it reads SUPABASE_URL, falling back
# to NEXT_PUBLIC_SUPABASE_URL. The publishable key is used by the frontend.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key

# --- AI generation provider ---
# Which generator to use: 'gemini' (cloud), 'ollama' (local generative LLM),
# or 'custom'. Falls back to the extractive ML pipeline on any provider error.
AI_PROVIDER=gemini

# --- AI generation (Gemini) ---
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.8-flash
GEMINI_MODEL_FALLBACKS=gemini-flash-latest,gemini-3.1-flash-lite,gemini-2.5-flash
# Fall back to the local ML pipeline when Gemini quota is exhausted.
USE_LOCAL_FALLBACK_ON_QUOTA=True

# --- Local generative LLM (Ollama) ---
# Fully local, no cloud. To use: install Ollama (`brew services start ollama`),
# `ollama pull llama3.2:3b`, then set AI_PROVIDER=ollama and USE_ML_PRIMARY=False.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_TIMEOUT=120
# Document excerpts generated from per request. Each excerpt costs one model
# call, so this is the main latency/coverage dial: 3 ~= 20s, 5 ~= 35s.
RAG_CHUNKS=3

# --- Scheduling ---
# Decides where the day boundary falls, which is what "due today" means to the
# spaced-repetition schedule. Set this to the learner's zone: on UTC, a card due
# today only appears once UTC catches up, so early mornings wrongly read as
# "nothing due". Timestamps are stored in UTC regardless.
TIME_ZONE=Asia/Ho_Chi_Minh

# --- ML pipeline ---
# When True, use the local classical ML generators as the PRIMARY generator
# instead of Gemini. Retrain the model first (see ml_pipeline) before enabling.
USE_ML_PRIMARY=False
MAX_PDF_UPLOAD_MB=10

# --- Email (planned-test reminders) ---
# Leave EMAIL_HOST empty to print reminders to the console instead of sending.
# Use a provider APP PASSWORD, never your account password.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=StudyFlow <no-reply@studyflow.local>

# Base URL the reminder links back to.
FRONTEND_URL=http://localhost:3000
