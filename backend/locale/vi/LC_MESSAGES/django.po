msgid "The tutor needs the AI provider, which is not available right now."
msgstr "Gia sư cần AI, hiện đang không khả dụng."

msgid "The tutor could not answer just now. Try again in a minute."
msgstr "Gia sư chưa trả lời được lúc này. Hãy thử lại sau một phút."

msgid ""
"Only the person who made this card, or the notebook owner, can change it."
msgstr "Chỉ người tạo thẻ này hoặc chủ sổ tay mới sửa được."

msgid "Ask something first."
msgstr "Hãy đặt câu hỏi trước."

msgid "history must be a list of turns."
msgstr "history phải là danh sách các lượt."

msgid ""
"That is the third question on this card — try recalling it again, then come "
"back if it is still unclear."
msgstr ""
"Đây là câu hỏi thứ ba cho thẻ này — hãy thử nhớ lại lần nữa, nếu vẫn chưa rõ "
"thì quay lại sau."

msgid "Only http and https links can be added."
msgstr "Chỉ thêm được liên kết http hoặc https."

msgid "That link has no host."
msgstr "Liên kết này không có tên máy chủ."

msgid "That host could not be found."
msgstr "Không tìm thấy máy chủ đó."

msgid "Links to private or local addresses cannot be added."
msgstr "Không thể thêm liên kết tới địa chỉ nội bộ hoặc cục bộ."

#, python-format
msgid "Could not fetch that link (%(why)s)."
msgstr "Không tải được liên kết đó (%(why)s)."

msgid ""
"That site blocks automated access. Download the file in your browser and "
"upload it here instead."
msgstr ""
"Trang này chặn truy cập tự động. Hãy tải file về bằng trình duyệt rồi tải "
"lên ở đây."

#, python-format
msgid "Could not fetch that link (HTTP %(status)s)."
msgstr "Không tải được liên kết đó (HTTP %(status)s)."

msgid "That page is too large to import."
msgstr "Trang này quá lớn để nhập."

msgid "That link is not a web page or a PDF. Upload the file instead."
msgstr ""
"Liên kết này không phải trang web hay PDF. Hãy tải file lên thay vì dán link."

msgid "No readable text was found on that page."
msgstr "Không tìm thấy văn bản đọc được trên trang đó."

msgid ""
"This document is in Vietnamese, which needs an AI provider (Ollama or "
"Gemini) — the offline generator only handles English. Check the provider and "
"try again."
msgstr ""
"Tài liệu này là tiếng Việt nên cần AI provider (Ollama hoặc Gemini) — trình "
"tạo offline chỉ hỗ trợ tiếng Anh. Hãy kiểm tra provider rồi thử lại."

msgid "This invitation has already been used. Ask for a new link."
msgstr "Liên kết mời này đã được dùng. Hãy xin liên kết mới."

msgid "flashcard set"
msgstr "bộ thẻ"

msgid "quiz"
msgstr "bài kiểm tra"

#, python-format
msgid ""
"This source is too short to generate a %(kind)s (%(count)s words; needs at "
"least %(min)s). Add more text or choose a longer document."
msgstr ""
"Tài liệu này quá ngắn để tạo %(kind)s (%(count)s từ; cần ít nhất %(min)s). "
"Hãy thêm nội dung hoặc chọn tài liệu dài hơn."

msgid "No sources selected."
msgstr "Chưa chọn tài liệu nào."

msgid "Only the notebook owner can change it."
msgstr "Chỉ chủ sổ tay mới sửa được."

msgid "Only the notebook owner can delete it."
msgstr "Chỉ chủ sổ tay mới xoá được."

#, python-format
msgid "That text is too short to study from. Paste at least %(n)s words."
msgstr "Đoạn văn bản quá ngắn để học. Hãy dán ít nhất %(n)s từ."

msgid "Paste a link first."
msgstr "Hãy dán liên kết trước."

msgid "No readable text was found in that PDF. It may be scanned images only."
msgstr ""
"Không tìm thấy văn bản đọc được trong PDF đó. Có thể file chỉ gồm ảnh scan."

msgid "That page has too little text to study from."
msgstr "Trang này có quá ít văn bản để học."

msgid "No file provided."
msgstr "Chưa có file nào được gửi."

#, python-format
msgid "Unsupported file type. Supported: %(formats)s."
msgstr "Định dạng file không được hỗ trợ. Hỗ trợ: %(formats)s."

#, python-format
msgid "File too large. Max size is %(mb)s MB."
msgstr "File quá lớn. Tối đa %(mb)s MB."

msgid "Choose at least one source."
msgstr "Hãy chọn ít nhất một tài liệu."

msgid "One or more sources are not in this notebook."
msgstr "Có tài liệu không thuộc sổ tay này."

msgid "Only the notebook owner can invite people."
msgstr "Chỉ chủ sổ tay mới mời được người khác."

msgid "Enter an email address."
msgstr "Hãy nhập địa chỉ email."

msgid "That is your own address."
msgstr "Đó là địa chỉ của chính bạn."

msgid "Only the notebook owner can remove people."
msgstr "Chỉ chủ sổ tay mới gỡ được thành viên."

msgid "The owner cannot leave their own notebook."
msgstr "Chủ sổ tay không thể rời sổ tay của mình."

msgid "kind must be flashcards or questions."
msgstr "kind phải là flashcards hoặc questions."

msgid "This invitation link is not valid."
msgstr "Liên kết mời này không hợp lệ."

msgid "Message not found."
msgstr "Không tìm thấy tin nhắn."

msgid "Only the person who wrote it can delete a message."
msgstr "Chỉ người viết mới xoá được tin nhắn."

msgid "members must be a list of user ids."
msgstr "members phải là danh sách id người dùng."

msgid "You can only add people you share a notebook with."
msgstr "Bạn chỉ thêm được người có chung sổ tay."

msgid "Give the group a name."
msgstr "Hãy đặt tên cho nhóm."

msgid "Group not found."
msgstr "Không tìm thấy nhóm."

msgid "You are not in this group."
msgstr "Bạn không ở trong nhóm này."

msgid "A message must have text, and stay under 2000 characters."
msgstr "Tin nhắn phải có nội dung và dưới 2000 ký tự."

msgid "You can only leave a group yourself."
msgstr "Bạn chỉ có thể tự rời nhóm."

msgid "Person not found."
msgstr "Không tìm thấy người này."

msgid "You cannot message yourself."
msgstr "Bạn không thể tự nhắn cho mình."

msgid "You can only message people you share a notebook with."
msgstr "Bạn chỉ nhắn được cho người có chung sổ tay."

msgid "Not your quiz."
msgstr "Đây không phải quiz của bạn."

msgid "The correct answer must be one of the options."
msgstr "Đáp án đúng phải là một trong các phương án."

msgid "Notebook not found."
msgstr "Không tìm thấy sổ tay."

msgid "Pick a time in the future."
msgstr "Chọn một thời điểm trong tương lai."

msgid "Explanations need the AI provider, which is not available right now."
msgstr "Giải thích cần AI, hiện đang không khả dụng."

msgid "Could not write an explanation. Try again in a minute."
msgstr "Không viết được lời giải thích. Hãy thử lại sau một phút."

msgid "These questions have no source text to practise from."
msgstr "Các câu này không có văn bản nguồn để luyện."

msgid "Practice needs the AI provider, which is not available right now."
msgstr "Luyện tập cần AI, hiện đang không khả dụng."

msgid "Could not write the practice questions. Try again in a minute."
msgstr "Không viết được câu luyện tập. Hãy thử lại sau một phút."

msgid "Practice on a concept you kept missing"
msgstr "Luyện một khái niệm bạn hay sai"

msgid ""
"Only the person who made this question, or the notebook owner, can change it."
msgstr "Chỉ người tạo câu hỏi này hoặc chủ sổ tay mới sửa được."

msgid "Not allowed."
msgstr "Không được phép."

msgid "This attempt is already complete."
msgstr "Lượt làm bài này đã hoàn thành."

msgid "Type an answer first."
msgstr "Hãy gõ câu trả lời trước."

msgid "Question not part of this quiz."
msgstr "Câu hỏi không thuộc bài kiểm tra này."

msgid "Answer not part of this attempt."
msgstr "Câu trả lời không thuộc lượt làm bài này."

msgid "Only typed answers can be overridden."
msgstr "Chỉ câu trả lời tự gõ mới sửa được điểm."

msgid "question_ids must be a non-empty list."
msgstr "question_ids phải là danh sách không rỗng."

msgid "Those questions are not in your mistake bank for this notebook."
msgstr "Các câu đó không nằm trong ngân hàng lỗi sai của sổ tay này."

msgid "a weak concept"
msgstr "một khái niệm còn yếu"

msgid "Planned test not found."
msgstr "Không tìm thấy lịch thi thử."

msgid "This planned test has already been sat."
msgstr "Lịch thi thử này đã được thi."

#, python-format
msgid "This test opens at %(when)s."
msgstr "Bài thi này mở lúc %(when)s."

#, python-format
msgid "Number of questions: %(why)s"
msgstr "Số câu hỏi: %(why)s"

#, python-format
msgid "Duration: %(why)s"
msgstr "Thời lượng: %(why)s"

msgid "Nothing in the mistake bank for this notebook yet."
msgstr "Ngân hàng lỗi sai của sổ tay này chưa có câu nào."

msgid ""
"No questions could be generated for this notebook. Check its documents have "
"finished processing, then try generating a quiz from them."
msgstr ""
"Chưa tạo được câu hỏi nào cho sổ tay này. Hãy kiểm tra các tài liệu đã xử lý "
"xong, rồi thử tạo bài kiểm tra từ chúng."

msgid "This test has already been submitted."
msgstr "Bài thi này đã được nộp."

msgid "Time is up for this test."
msgstr "Đã hết giờ làm bài."

msgid "Question not part of this test."
msgstr "Câu hỏi không thuộc bài thi này."

msgid "Submit the paper first."
msgstr "Hãy nộp bài trước."

msgid "Question not part of this paper."
msgstr "Câu hỏi không thuộc đề thi này."

msgid "That answer was right."
msgstr "Câu đó bạn đã trả lời đúng."

msgid "Could not delete the account right now. Try again in a minute."
msgstr "Hiện không xoá được tài khoản. Hãy thử lại sau một phút."

#~ msgid "Could not fetch that link."
#~ msgstr "Không tải được liên kết đó."
