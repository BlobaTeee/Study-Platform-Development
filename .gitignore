# Environment variables
.env*.local
backend/.env
# Anything derived from it holds the same credentials (DB password, API keys).
backend/.env.*
# ...except the template, which is checked in and holds no values.
!backend/.env.example

# Dependencies and build
node_modules
.next/
.vercel/
backend/venv/

# Python
__pycache__/
*.pyc
backend/db.sqlite3
backend/media/
ml_pipeline/.venv/
ml_pipeline/outputs/
**/.ipynb_checkpoints/
*.egg-info/

# Build caches
tsconfig.tsbuildinfo

# Local editor settings
.vscode/

# ML pipeline regenerable artifacts
ml_pipeline/models/*.joblib
# Note: datasets/processed/*.parquet ARE committed (small, portable outputs) — see datasets/README.md

# Large raw dataset kept out of git (137 MB, regenerable from source — see datasets/README.md)
datasets/raw/AI Flashcards/*.csv
# Duolingo learning traces (379 MB, CC BY-NC 4.0) — download from Harvard Dataverse, see datasets/README.md
datasets/raw/Duolingo/*.csv.gz

# IDE parquet-viewer artifacts
*.parquet.as.json

# OS
.DS_Store

# Compiled gettext catalogues (manage.py compilemessages)
*.mo

# Django file cache (concept names, forgotten-card groups)
backend/.cache/
